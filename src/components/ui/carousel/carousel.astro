---
import type { HTMLAttributes } from "astro/types"
import type { EmblaOptionsType } from "embla-carousel"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"section"> & {
  opts?: EmblaOptionsType
  orientation?: "horizontal" | "vertical"
}

const {
  class: className,
  opts,
  orientation = opts?.axis === "y" ? "vertical" : "horizontal",
  "aria-roledescription": roleDescription = "carousel",
  "data-slot": dataSlot = "carousel",
  // A named section is a region landmark. Without a name it would have no
  // role, so it becomes a group, the other container role the APG carousel
  // allows.
  role = Astro.props["aria-label"] || Astro.props["aria-labelledby"]
    ? undefined
    : "group",
  ...props
} = Astro.props

const resolvedOpts: EmblaOptionsType = {
  ...opts,
  axis: orientation === "horizontal" ? "x" : "y",
}
---

<section
  data-slot={dataSlot}
  data-orientation={orientation}
  data-carousel-options={JSON.stringify(resolvedOpts)}
  class={cn("group/carousel relative", className)}
  role={role}
  aria-roledescription={roleDescription}
  {...props}
>
  <slot />
</section>

<script>
  import EmblaCarousel, {
    type EmblaCarouselType,
    type EmblaOptionsType,
  } from "embla-carousel"

  type CarouselRoot = HTMLElement & {
    __fulldevCarouselApi?: EmblaCarouselType
  }

  // A nested carousel owns its own parts. The data-carousel-* markers stay
  // in place when a caller overrides data-slot.
  const rootSelector = "[data-carousel-options]"
  const getParts = <T extends Element>(root: CarouselRoot, part: string) =>
    [...root.querySelectorAll<T>(`[data-carousel-${part}]`)].filter(
      (element) => element.closest(rootSelector) === root
    )
  for (const root of document.querySelectorAll<CarouselRoot>(rootSelector)) {
    const viewport = getParts<HTMLElement>(root, "viewport")[0]
    if (!viewport) continue

    const opts: EmblaOptionsType = JSON.parse(
      root.dataset.carouselOptions || "{}"
    )
    const api = EmblaCarousel(viewport, opts)
    root.__fulldevCarouselApi = api
    const previous = getParts<HTMLButtonElement>(root, "previous")
    const next = getParts<HTMLButtonElement>(root, "next")
    const emit = (type: "carousel:init" | "carousel:select") => {
      root.dispatchEvent(
        new CustomEvent(type, {
          detail: {
            api,
            canScrollPrev: api.canScrollPrev(),
            canScrollNext: api.canScrollNext(),
            selectedScrollSnap: api.selectedScrollSnap(),
            scrollSnapList: api.scrollSnapList(),
          },
        })
      )
    }
    const sync = () => {
      root.dataset.canScrollPrev = String(api.canScrollPrev())
      root.dataset.canScrollNext = String(api.canScrollNext())
      root.dataset.selectedScrollSnap = String(api.selectedScrollSnap())
      for (const button of previous)
        if (button.dataset.manualDisabled !== "true")
          button.disabled = !api.canScrollPrev()
      for (const button of next)
        if (button.dataset.manualDisabled !== "true")
          button.disabled = !api.canScrollNext()
      emit("carousel:select")
    }
    const jump = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const onPrevious = () => api.scrollPrev(jump())
    const onNext = () => api.scrollNext(jump())
    const onKeyDown = (event: KeyboardEvent) => {
      const target = event.target
      if (
        event.defaultPrevented ||
        !(target instanceof Element) ||
        target.closest(rootSelector) !== root ||
        target.closest(
          'input, textarea, select, [contenteditable]:not([contenteditable="false"])'
        )
      )
        return

      const vertical = root.dataset.orientation === "vertical"
      switch (event.key) {
        case vertical ? "ArrowUp" : "ArrowLeft":
          onPrevious()
          break
        case vertical ? "ArrowDown" : "ArrowRight":
          onNext()
          break
        case "Home":
          api.scrollTo(0, jump())
          break
        case "End":
          api.scrollTo(api.scrollSnapList().length - 1, jump())
          break
        default:
          return
      }
      event.preventDefault()
    }

    for (const button of previous)
      button.addEventListener("click", onPrevious)
    for (const button of next) button.addEventListener("click", onNext)
    root.addEventListener("keydown", onKeyDown)
    api.on("select", sync)
    api.on("reInit", sync)
    sync()
    requestAnimationFrame(() => emit("carousel:init"))
  }
</script>
