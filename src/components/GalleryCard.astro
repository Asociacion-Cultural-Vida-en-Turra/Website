---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  album: CollectionEntry<"gallery">;
}

const { album } = Astro.props;
const { title, description, cover, coverAlt, items } = album.data;
const photoCount = items.filter((item) => item.type === "image").length;
const videoCount = items.filter((item) => item.type === "video").length;
const countLabel = [
  photoCount > 0 ? `${photoCount} ${photoCount === 1 ? "foto" : "fotos"}` : "",
  videoCount > 0 ? `${videoCount} ${videoCount === 1 ? "vídeo" : "vídeos"}` : "",
].filter(Boolean).join(" · ") || "0 elementos";
const group = `gallery-${album.id}`;
const slides = await Promise.all(items.map(async (item) => {
  const image = item.type === "image" ? item.image : item.poster ?? cover;
  const [full, thumb] = await Promise.all([
    getImage({ src: image, width: Math.min(1920, image.width), format: "webp" }),
    getImage({ src: image, width: Math.min(200, image.width), format: "webp" }),
  ]);
  const isFile = item.type === "video" && /\.(mp4|webm|ogv)(?:[?#]|$)/i.test(item.src);
  return {
    src: item.type === "image" ? full.src : item.src.startsWith("videos/") ? `${import.meta.env.BASE_URL}${item.src}` : item.src,
    alt: item.type === "image" ? item.alt : item.title,
    caption: item.caption,
    thumb: thumb.src,
    poster: item.type === "video" ? full.src : undefined,
    fancyboxType: item.type === "image" ? "image" : isFile ? "html5video" : undefined,
  };
}));
// Fancybox renders captions as HTML; keep content authors' captions as plain text.
const escapeCaption = (value: string) => value.replace(/[&<>"']/g, (character) => ({
  "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
}[character as "&" | "<" | ">" | '"' | "'"]!));
const first = slides[0];
---

<article class="collection">
  <Image
    class="cover"
    src={cover}
    alt={coverAlt}
    widths={[400, 800]}
    sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
    loading="lazy"
  />
  <p class="count">{countLabel}</p>
  <h2>{title}</h2>
  <p class="description">{description}</p>
  {first ? (
    <a
      class="open-gallery"
      href={first.src}
      data-fancybox={group}
      data-caption={escapeCaption(first.caption ?? "")}
      data-alt={first.alt}
      data-thumb={first.thumb}
      data-type={first.fancyboxType}
      data-poster={first.poster}
      aria-label={`Ver colección: ${title}`}
      aria-haspopup="dialog"
    >
      Ver colección <span aria-hidden="true">↗</span>
    </a>
  ) : (
    <p class="empty">Esta colección todavía no tiene fotos ni vídeos.</p>
  )}
  <div hidden>
    {slides.slice(1).map((slide) => (
      <a
        href={slide.src}
        data-fancybox={group}
        data-caption={escapeCaption(slide.caption ?? "")}
        data-alt={slide.alt}
        data-thumb={slide.thumb}
        data-type={slide.fancyboxType}
        data-poster={slide.poster}
      >{slide.alt}</a>
    ))}
  </div>
</article>

<style>
  .collection {
    position: relative;
    min-width: 0;
  }
  .cover {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 7;
    object-fit: cover;
  }
  .count {
    margin: 1.375rem 0 0.875rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: var(--font-semibold);
  }
  h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.5rem;
    line-height: 1.3;
    text-wrap: initial;
  }
  .description {
    margin: 0.75rem 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .open-gallery, .empty {
    display: block;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .empty {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .open-gallery span {
    margin-left: 0.25rem;
  }
  .open-gallery::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .open-gallery:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .open-gallery:focus-visible {
    outline: none;
  }
  .open-gallery:focus-visible::after {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 4px;
  }
</style>
