---
import Button from "@components/Button.astro";

interface Props {
  /** Unique prefix for field IDs; generated automatically when omitted. */
  id?: string;
}

const { id = `form-${crypto.randomUUID()}` } = Astro.props;
---

<form id={id} data-validated-form aria-describedby={`${id}-note`}>
  <fieldset disabled>
    <legend class="sr-only">Formulario de contacto</legend>
    <div class="form-fields">
      <div class="field">
        <label for={`${id}-name`}>Nombre</label>
        <input id={`${id}-name`} name="name" type="text" autocomplete="name" placeholder="Tu nombre" maxlength="120" required aria-describedby={`${id}-name-error`} />
        <p id={`${id}-name-error`} class="error" hidden></p>
      </div>
      <div class="field">
        <label for={`${id}-email`}>Correo electrónico</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="tu@correo.es" maxlength="254" required aria-describedby={`${id}-email-error`} />
        <p id={`${id}-email-error`} class="error" hidden></p>
      </div>
      <div class="field full-width">
        <label for={`${id}-message`}>Mensaje</label>
        <textarea id={`${id}-message`} name="message" placeholder="Cuéntanos tu idea…" rows="5" maxlength="5000" required aria-describedby={`${id}-message-error`}></textarea>
        <p id={`${id}-message-error`} class="error" hidden></p>
      </div>
      <div class="field full-width">
        <label class="privacy" for={`${id}-privacy`}>
          <input id={`${id}-privacy`} name="privacy" type="checkbox" required aria-describedby={`${id}-privacy-error`} />
          <span>He leído y acepto la política de privacidad.</span>
        </label>
        <p id={`${id}-privacy-error`} class="error" hidden></p>
      </div>
    </div>
    <Button type="submit">Enviar mensaje <span aria-hidden="true">↗</span></Button>
  </fieldset>
  <p id={`${id}-note`} class="form-note">Todos los campos son obligatorios. El envío aún no está disponible.</p>
  <p id={`${id}-status`} class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-validated-form]").forEach((form) => {
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea"));
    const status = form.querySelector<HTMLParagraphElement>(".form-status")!;

    function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
      let message = "";
      if (field instanceof HTMLInputElement && field.type === "checkbox") {
        if (!field.checked) message = "Debes aceptar la política de privacidad.";
      } else if (!field.value.trim()) {
        message = field.name === "name" ? "Escribe tu nombre." : field.name === "email" ? "Escribe tu correo electrónico." : "Escribe un mensaje.";
      } else if (field.validity.typeMismatch) {
        message = "Introduce un correo electrónico válido, como tu@correo.es.";
      } else if (field.validity.tooLong) {
        message = `Usa un máximo de ${field.maxLength} caracteres.`;
      }

      const error = field.closest(".field")!.querySelector<HTMLParagraphElement>(".error")!;
      error.textContent = message;
      error.hidden = !message;
      field.setAttribute("aria-invalid", String(Boolean(message)));
      return !message;
    }

    fields.forEach((field) => {
      field.addEventListener("blur", () => validateField(field));
      field.addEventListener("input", () => {
        status.textContent = "";
        if (field.getAttribute("aria-invalid") === "true") validateField(field);
      });
      if (field instanceof HTMLInputElement && field.type === "checkbox") {
        field.addEventListener("change", () => validateField(field));
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      status.textContent = "";
      const invalidFields = fields.filter((field) => !validateField(field));
      if (invalidFields.length) {
        status.textContent = "Revisa los campos señalados antes de continuar.";
        invalidFields[0].focus();
        return;
      }
      status.textContent = "Los datos son válidos. El envío aún no está disponible; tu mensaje no se ha enviado.";
    });

    // Enable only after attaching the handler: this preview must never submit data.
    form.noValidate = true;
    form.querySelector("fieldset")!.disabled = false;
  });
</script>

<style>
  form, .field {
    min-width: 0;
  }
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .form-fields {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  input:not([type="checkbox"]), textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.875rem 1rem;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    line-height: 1.5;
  }
  textarea {
    min-height: 7.5rem;
    resize: vertical;
  }
  input::placeholder, textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }
  input:focus-visible, textarea:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 3px;
  }
  input[aria-invalid="true"], textarea[aria-invalid="true"] {
    border-color: var(--color-accent);
  }
  .privacy {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .privacy input {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin: 0.0625rem 0 0;
    accent-color: var(--color-primary);
  }
  .error {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .form-note {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .form-status {
    margin: 1rem 0 0;
    color: var(--color-primary);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .form-status:empty {
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @media (min-width: 48rem) {
    .form-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .full-width {
      grid-column: 1 / -1;
    }
  }
</style>
