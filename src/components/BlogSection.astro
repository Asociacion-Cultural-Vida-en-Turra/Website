---
import Button from "@components/Button.astro";
import BlogGrid from "@components/BlogGrid.astro";
---

<section id="blog" class="blog" aria-labelledby="blog-title">
  <header class="blog-heading">
    <div>
      <p class="eyebrow">El día a día</p>
      <h2 id="blog-title">Lo último de la asociación</h2>
    </div>
    <p class="blog-note">Nuestro tablón, siempre abierto.</p>
  </header>
  <BlogGrid id="home-blog" limit={3} />
  <div class="blog-actions">
    <Button href="/blog/" variant="secondary">Ver todas las publicaciones <span aria-hidden="true">→</span></Button>
  </div>
</section>

<style>
  .blog {
    box-sizing: border-box;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 4vw, 5rem);
  }
  .blog-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-size: 0.625rem;
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .blog-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .blog-actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .blog-actions span {
    margin-left: 0.5rem;
  }
  @media (min-width: 75rem) {
    .blog {
      max-width: 96rem;
    }
  }
</style>
