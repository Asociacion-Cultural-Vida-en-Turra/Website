---
import { Image } from "astro:assets"
import logoIglesia from "@assets/logoIglesia.png"
---
<a href="/" class="a">
    <div class="brand">
        <Image src={logoIglesia} alt="" class="brand-logo"/>
        <span class="brand-text">
            <span class="brand-title">Vida en Turra</span>
            <span class="brand-subtitle">Asociación Cultural y Medioambiental</span>
        </span>
    </div>
</a>

<style>
    .a {
        text-decoration: none;
        min-width: 0;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: clamp(0.5rem, 1.5vw, 1rem);
        color: var(--color-primary);
    }
    .brand-logo {
        width: clamp(3rem, 8vw, 6rem);
        flex-shrink: 0;
        height: auto;
    }
    .brand-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 0.3em;
    }
    .brand-title {
        font-family: var(--font-heading);
        font-weight: var(--font-bold);
        font-size: clamp(1.25rem, 0.9rem + 1.5vw, 2.5rem);
        line-height: 1.15;
    }
    .brand-subtitle {
        font-family: var(--font-body);
        font-weight: var(--font-semibold);
        font-size: clamp(0.75rem, 0.65rem + 0.4vw, 1rem);
        line-height: 1.4;
    }
</style>
