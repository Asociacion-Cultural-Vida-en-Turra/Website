---
import AssociationHelp from "./AssociationHelp.astro";
import AssociationIntro from "./AssociationIntro.astro";
import Map from "@components/Map.astro";
---

<section id="asociacion" class="association" aria-labelledby="association-title">
  <div class="association-content">
    <AssociationIntro />
    <Map address="Turra de Alba, 37871, Salamanca" />
    <AssociationHelp />
    <blockquote class="association-quote">
      <p>
        «Llegar juntos es el principio. Mantenerse juntos es el progreso. Trabajar juntos es el éxito.
        Nadie sobra. Ninguno de nosotros es tan inteligente como todos nosotros juntos.»
      </p>
    </blockquote>
  </div>
</section>

<style>
  .association {
    background: var(--color-surface-muted);
    scroll-margin-top: 2rem;
  }

  .association-content {
    box-sizing: border-box;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 4vw, 5rem);
  }

  :global(.association .eyebrow) {
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-size: 0.625rem;
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  :global(.association h2) {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .association-quote {
    margin: clamp(3rem, 5vw, 5rem) 0 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left: 3px solid var(--color-accent);
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
  }

  .association-quote p {
    max-width: 54rem;
    margin: 0;
  }

  @media (min-width: 75rem) {
    .association-content {
      max-width: 96rem;
    }
  }
</style>
