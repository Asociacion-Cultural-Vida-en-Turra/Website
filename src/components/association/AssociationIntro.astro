---
import Button from "@components/Button.astro";
---

<div class="association-intro">
  <header>
    <p class="eyebrow">La asociación</p>
    <h2 id="association-title">Lo que nos une<br />es nuestro pueblo.</h2>
  </header>
  <div class="association-description">
    <p class="association-name">Asociación Cultural y Medioambiental «Vida en Turra»</p>
    <p class="lead">
      Un lugar para encontrarnos, compartir ideas y mantener viva la vida de Turra de Alba.
    </p>
    <p class="description">
      Este blog reúne nuestras noticias, encuentros y recuerdos. Para quienes viven aquí y para
      quienes llevan el pueblo consigo, estén donde estén.
    </p>
    <Button
      href={`${import.meta.env.BASE_URL}participa/`}
      target="_blank"
      variant="secondary"
    >
      Quiero participar <span aria-hidden="true">↗</span>
    </Button>
  </div>
</div>

<style>
  .association-intro {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .association-name {
    margin: 0 0 1rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: var(--font-semibold);
    line-height: 1.6;
  }

  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .description {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .association-intro {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 7vw, 8rem);
    }
  }
</style>
