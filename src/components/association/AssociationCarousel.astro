---
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@components/ui/carousel";
import { linesOfAction } from "./lines-of-action";
---

<section class="association-carousel-section" aria-labelledby="association-carousel-title">
  <div class="association-carousel-inner">
    <header class="carousel-heading">
      <h2 id="association-carousel-title">Conócenos</h2>
    </header>
    <Carousel
      id="association-carousel"
      class="association-carousel"
      aria-label="Conoce la asociación"
      aria-roledescription="carrusel"
      opts={{ loop: true }}
    >
      <CarouselContent class="association-carousel-content">
        <CarouselItem
          class="association-carousel-item"
          aria-label="Quiénes somos"
          aria-roledescription="diapositiva"
        >
          <article class="association-carousel-slide association-carousel-slide--feature">
            <p class="association-slide-index">01</p>
            <h3>Quiénes somos</h3>
            <p class="association-slide-body">
              Somos un grupo de vecinos de Turra de Alba unidos en una asociación cultural y medioambiental sin ánimo de lucro por el respeto a las tradiciones locales, el arte, la cultura, la regeneración y la protección de nuestro entorno cultural y medioambiental.
            </p>
          </article>
        </CarouselItem>
        <CarouselItem
          class="association-carousel-item"
          aria-label="Nuestra misión"
          aria-roledescription="diapositiva"
        >
          <article class="association-carousel-slide association-carousel-slide--feature">
            <p class="association-slide-index">02</p>
            <h3>Nuestra misión</h3>
            <p class="association-slide-body">
              Fomentar el desarrollo sostenible y la conciencia ecológica a través de actividades
              culturales, talleres educativos y proyectos de recuperación y conservación ambiental
              en Turra de Alba.
            </p>
          </article>
        </CarouselItem>
        <CarouselItem
          class="association-carousel-item"
          aria-label="Nuestra visión"
          aria-roledescription="diapositiva"
        >
          <article class="association-carousel-slide association-carousel-slide--feature">
            <p class="association-slide-index">03</p>
            <h3>Nuestra visión</h3>
            <p class="association-slide-body">
              Convertirnos en un referente de convivencia armónica entre el ser humano, la cultura
              comunitaria y la naturaleza.
            </p>
          </article>
        </CarouselItem>
        <CarouselItem
          class="association-carousel-item"
          aria-label="Nuestros valores"
          aria-roledescription="diapositiva"
        >
          <article class="association-carousel-slide">
            <p class="association-slide-index">04</p>
            <h3>Nuestros valores</h3>
            <ul class="association-carousel-values">
              <li>
                <h4>Sostenibilidad</h4>
                <p>Nuestras actividades respetan el equilibrio ecológico.</p>
              </li>
              <li>
                <h4>Identidad cultural</h4>
                <p> Divulgamos el arte, la historia de nuestras gentes y las costumbres locales. </p>
              </li>
              <li>
                <h4>Patrimonio medioambiental</h4>
                <p>Actuaciones encaminadas a recuperar y proteger las zonas verdes, el agua, la fauna y flora del lugar.</p>
              </li>
              <li>
                <h4>Comunidad</h4>
                <p>Creemos en el poder de la acción colectiva, la inclusión y la ilusión por conservar nuestras raíces culturales y nuestro patrimonio.</p>
              </li>
            </ul>
          </article>
        </CarouselItem>
        <CarouselItem
          class="association-carousel-item"
          aria-label="Líneas de actuación"
          aria-roledescription="diapositiva"
        >
          <article class="association-carousel-slide">
            <p class="association-slide-index">05</p>
            <h3>Líneas de actuación</h3>
            <p class="association-slide-body">
              En colaboración con el Ayuntamiento y con otras entidades públicas y privadas de la
              provincia de Salamanca y de la Junta de Castilla y León:
            </p>
            <ul class="association-carousel-values">
              {linesOfAction.map((line) => (
                <li>
                  <h4>{line.number} · {line.title}</h4>
                  <p>{line.description}</p>
                </li>
              ))}
              <li class="association-slide-more-item">
                <p class="association-slide-more">Y mucho más…</p>
              </li>
            </ul>
          </article>
        </CarouselItem>
      </CarouselContent>
      <CarouselPrevious
        class="association-carousel-control association-carousel-control--previous"
        aria-label="Anterior"
      />
      <CarouselNext
        class="association-carousel-control association-carousel-control--next"
        aria-label="Siguiente"
      />
      <div class="association-carousel-dots" role="group" aria-label="Elegir diapositiva">
        {Array.from({ length: 5 }, (_, index) => (
          <button
            type="button"
            class="association-carousel-dot"
            data-carousel-dot={index}
            aria-label={`Ir a la diapositiva ${index + 1}`}
            aria-current={index === 0 ? "true" : undefined}
          />
        ))}
      </div>
    </Carousel>
  </div>
</section>

<script>
  import type { CarouselApi } from "@components/ui/carousel";

  type CarouselElement = HTMLElement & {
    __fulldevCarouselApi?: CarouselApi;
  };

  const carousel = document.querySelector<CarouselElement>("#association-carousel");

  if (carousel) {
    let controlsInitialized = false;

    const initializeControls = () => {
      const api = carousel.__fulldevCarouselApi;
      if (!api || controlsInitialized) return;

      controlsInitialized = true;
      carousel.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse") return;

        const bounds = carousel.getBoundingClientRect();
        const edgeZone = Math.min(112, bounds.width * 0.2);

        if (event.clientX <= bounds.left + edgeZone) {
          carousel.dataset.arrowHover = "previous";
        } else if (event.clientX >= bounds.right - edgeZone) {
          carousel.dataset.arrowHover = "next";
        } else {
          delete carousel.dataset.arrowHover;
        }
      });
      carousel.addEventListener("pointerleave", () => {
        delete carousel.dataset.arrowHover;
      });

      const dots = carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]");
      const syncDots = () => {
        const selected = api.selectedScrollSnap();
        dots.forEach((dot, index) => {
          if (index === selected) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        });
      };

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          api.scrollTo(Number(dot.dataset.carouselDot));
        });
      });
      carousel.addEventListener("carousel:select", syncDots);
      syncDots();

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      window.setInterval(() => {
        if (carousel.matches(":hover") || carousel.contains(document.activeElement)) return;
        api.scrollNext();
      }, 6000);
    };

    carousel.addEventListener("carousel:init", initializeControls);
    requestAnimationFrame(initializeControls);
  }
</script>

<style>
  .association-carousel-section {
    padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 4vw, 5rem);
    background: var(--color-surface-muted);
  }

  .association-carousel-inner {
    max-width: 80rem;
    margin-inline: auto;
  }

  .carousel-heading {
    margin-bottom: 1.5rem;
  }

  .carousel-heading h2 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3rem);
  }

  :global(.association-carousel) {
    min-width: 0;
  }

  :global(.association-carousel-content) {
    margin-left: 0;
  }

  :global(.association-carousel-item) {
    padding-left: 0;
  }

  :global(.association-carousel-slide) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    height: 100%;
    min-height: clamp(24rem, 30vw, 30rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 4px;
    background: var(--color-background);
  }

  :global(.association-carousel-control) {
    z-index: 2;
    top: 50%;
    bottom: auto;
    width: 50px;
    height: 50px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--color-primary);
    cursor: pointer;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms,
      color 160ms ease;
  }

  :global(.association-carousel-control--previous) {
    left: 2rem;
  }

  :global(.association-carousel-control--next) {
    right: 2rem;
  }

  :global(.association-carousel-control svg) {
    width: 24px;
    height: 24px;
  }

  :global(.association-carousel-control:hover) {
    background: transparent;
    color: var(--color-accent);
  }

  :global(.association-carousel[data-arrow-hover="previous"] [data-carousel-previous]),
  :global(.association-carousel[data-arrow-hover="next"] [data-carousel-next]),
  :global(.association-carousel:focus-within .association-carousel-control) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 180ms ease,
      visibility 0s,
      color 160ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.association-carousel-control) {
      transition: none;
    }
  }

  :global(.association-carousel-dots) {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    gap: 0;
  }

  :global(.association-carousel-dot) {
    width: 1.25rem;
    height: 2px;
    padding: 0;
    border: 0;
    background: var(--color-border);
    cursor: pointer;
  }

  :global(.association-carousel-dot[aria-current="true"]) {
    background: var(--color-accent);
  }

  :global(.association-carousel-slide h3) {
    margin: 0 0 1rem;
    color: var(--color-primary);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  :global(.association-carousel-slide--feature h3) {
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }

  :global(.association-carousel-slide--feature .association-slide-index) {
    font-size: 1.125rem;
  }

  :global(.association-slide-index) {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: var(--font-semibold);
  }

  :global(.association-slide-body) {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  :global(.association-carousel-slide--feature .association-slide-body) {
    max-width: 54ch;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  :global(.association-carousel-values) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.association-carousel-values li) {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  :global(.association-carousel-values h4) {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  :global(.association-carousel-values p) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  :global(.association-slide-more) {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-weight: var(--font-semibold);
  }

  :global(li.association-slide-more-item) {
    display: flex;
    align-items: center;
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 48rem) {
    :global(.association-carousel-values) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }

    :global(.association-carousel-slide--feature h3) {
      font-size: clamp(2rem, 4vw, 3rem);
    }

    :global(.association-carousel-slide) {
      padding-inline: clamp(6rem, 7vw, 7.5rem);
    }

    :global(.association-carousel-slide--feature .association-slide-body) {
      font-size: clamp(1.125rem, 1.8vw, 1.35rem);
      line-height: 1.75;
    }
  }

  @media (min-width: 75rem) {
    .association-carousel-inner {
      max-width: 96rem;
    }
  }
</style>
