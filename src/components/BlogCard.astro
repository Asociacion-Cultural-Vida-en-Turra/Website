---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  headingLevel?: "h2" | "h3";
  title: string;
  category: string;
  date: string;
  dateLabel: string;
  description: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  coverLines?: string[];
  tone?: "sage" | "cream";
}
const { headingLevel: Heading = "h3", title, category, date, dateLabel, description, href, image, imageAlt="", coverLines = [], tone = "sage" } = Astro.props;
---

<article class="post" data-category={category}>
  {image ? (
    <Image class="cover" src={image} alt={imageAlt} widths={[400, 800]} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
  ) : (
    <div class:list={["cover", "text-cover", tone]} aria-hidden="true">
      <span>{coverLines.map((line) => <span class="cover-line">{line}</span>)}</span>
    </div>
  )}
  <p class="meta">{category} · <time datetime={date}>{dateLabel}</time></p>
  <Heading class="post-title">{title}</Heading>
  <p class="description">{description}</p>
  <a href={href} aria-label={`Leer historia: ${title}`}> Leer completo <span aria-hidden="true">↗</span></a>
</article>

<style>
  .post {
    position: relative;
    min-width: 0;
  }
  .cover {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 7;
    object-fit: cover;
  }
  .text-cover {
    display: flex;
    align-items: center;
    padding: clamp(1.25rem, 2.25vw, 2rem);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
  }
  .sage {
    background: var(--color-highlight);
  }
  .cream {
    background: var(--color-surface-muted);
  }
  .cover-line {
    display: block;
  }
  .meta {
    margin: 1.375rem 0 0.875rem;
    color: var(--color-accent);
    font-size: 0.625rem;
    font-weight: var(--font-semibold);
    line-height: 1.5;
    text-transform: uppercase;
  }
  .post-title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.3;
    text-wrap: initial;
  }
  .description {
    margin: 0.75rem 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  a {
    display: block;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: 0.875rem;
    text-decoration: none;
  }
  a span {
    margin-left: 0.25rem;
  }
  a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible::after {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 4px;
  }
</style>
