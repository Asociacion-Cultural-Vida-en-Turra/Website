---
import Layout from "@layouts/Layout.astro";
import BlogGrid from "@components/BlogGrid.astro";
---

<Layout title="Todas las publicaciones" description="Noticias, actividades e historias de la asociación y de Turra de Alba.">
  <main class="blog-index" aria-labelledby="blog-title">
    <header class="blog-heading">
      <p class="eyebrow">El día a día</p>
      <h1 id="blog-title">Todas las publicaciones</h1>
      <p class="intro">Noticias, encuentros e historias de nuestro pueblo. Nuestro tablón, siempre abierto.</p>
    </header>
    <BlogGrid id="all-blog" headingLevel="h2" />
  </main>
</Layout>

<style>
  .blog-index {
    box-sizing: border-box;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 4vw, 5rem);
  }
  .blog-heading {
    max-width: 48rem;
    margin-bottom: 3rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: var(--font-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
  }
  .intro {
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }
  @media (min-width: 75rem) {
    .blog-index {
      max-width: 96rem;
    }
  }
</style>
